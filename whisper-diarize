#!/usr/bin/env bash
# whisper-diarize launcher — portable, no hardcoded paths.
#
# Uses a project-local venv (./.venv) if present, else the WHISPER_DIARIZE_VENV
# env var, else falls back to a `python3` that has the package importable.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1) Project-local venv
if [ -x "$HERE/.venv/bin/python" ]; then
    exec "$HERE/.venv/bin/python" -m whisper_diarize "$@"
fi

# 2) Explicit override
if [ -n "${WHISPER_DIARIZE_VENV:-}" ] && [ -x "$WHISPER_DIARIZE_VENV/bin/python" ]; then
    exec "$WHISPER_DIARIZE_VENV/bin/python" -m whisper_diarize "$@"
fi

# 3) System python with the package installed (e.g. pipx / pip install -e .)
if PY_VERS="$(python3 -c 'import whisper_diarize; print("ok")' 2>/dev/null)"; then
    exec python3 -m whisper_diarize "$@"
fi

cat >&2 <<EOF
whisper-diarize: no usable Python environment found.

Set one up with:
  python3.12 -m venv "$HERE/.venv"
  source "$HERE/.venv/bin/activate"
  pip install -e .
  ./whisper-diarize --help
EOF
exit 1

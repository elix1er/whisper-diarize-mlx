# Normalize line endings across platforms
* text=auto eol=lf

# Shell scripts must stay LF
*.sh text eol=lf

# Notebooks are not diffed as source
*.ipynb -diff

# Treat the bundled sample as LFS-candidate if LFS is enabled; otherwise binary.
# (Repo stays small without LFS; this is a no-op if LFS isn't set up.)
*.wav filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
